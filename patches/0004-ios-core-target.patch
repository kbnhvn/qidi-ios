+# --- QIDISlicer pour iOS : moteur + ABI C, dans le même arbre -----------------
+# ios-core/ est installé ici par scripts/bootstrap.sh (copie de core/ du projet).
+# La cible réutilise SLIC3R_CLI_SOURCES — c'est-à-dire Slic3r::CLI::run, le point
+# d'entrée que le binaire desktop utilise déjà — pour slicer dans le processus de
+# l'app, sans sous-processus (impossibles sous iOS).
+option(SLIC3R_IOS_CORE "Build the iOS engine wrapper (ios-core/)" OFF)
+if (SLIC3R_IOS_CORE)
+    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../ios-core ios-core)
+endif ()
