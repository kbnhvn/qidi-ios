diff --git a/CMakeLists.txt b/CMakeLists.txt
index 93b2c9f..09ac488 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -26,6 +26,15 @@ endif()
 option(SLIC3R_STATIC 			"Compile QIDISlicer with static libraries (Boost, TBB, glew)" ${SLIC3R_STATIC_INITIAL})
 option(SLIC3R_GUI    			"Compile QIDISlicer with GUI components (OpenGL, wxWidgets)" 1)
 option(SLIC3R_FHS               "Assume QIDISlicer is to be installed in a FHS directory structure" 0)
+
+# --- Portage iPadOS -----------------------------------------------------------
+# wxWidgets n'a pas de backend iOS (wxOSX/iPhone est un stub) : sur iOS, seule la
+# moitié « moteur » du projet est compilée. L'application iOS fournit son
+# interface et consomme l'ABI C de ios-core/.
+if ((CMAKE_SYSTEM_NAME STREQUAL "iOS") AND SLIC3R_GUI)
+    message(FATAL_ERROR
+        "SLIC3R_GUI=ON n'est pas supporté sur iOS : configurer avec -DSLIC3R_GUI=OFF.")
+endif()
 option(SLIC3R_PCH               "Use precompiled headers" 1)
 option(SLIC3R_MSVC_COMPILE_PARALLEL "Compile on Visual Studio in parallel" 1)
 option(SLIC3R_ASAN              "Enable ASan on Clang and GCC" 0)
@@ -72,6 +81,18 @@ if (APPLE)
     endif ()
 endif ()
 
+# iOS : la comparaison ci-dessus ne veut rien dire. CMAKE_SYSTEM_PROCESSOR y est
+# vide (ou vaut celui de l'hôte, donc « arm64 » sur un Mac Apple Silicon), si bien
+# que le code croit à un build natif et tente de compiler *et d'exécuter* les tests.
+# Le toolchain iOS annonce donc la plateforme explicitement.
+if (CMAKE_SYSTEM_NAME STREQUAL "iOS" OR QSID_IS_IOS)
+    set(IS_CROSS_COMPILE TRUE)
+    if (SLIC3R_ENABLE_FORMAT_STEP AND NOT QSID_ALLOW_STEP_IOS)
+        message(STATUS "iOS : import STEP (OCCT) désactivé (relancer avec -DQSID_ALLOW_STEP_IOS=ON pour l'activer)")
+        set(SLIC3R_ENABLE_FORMAT_STEP OFF CACHE BOOL "" FORCE)
+    endif ()
+endif ()
+
 option(SLIC3R_BUILD_SANDBOXES   "Build development sandboxes" OFF)
 option(SLIC3R_BUILD_TESTS       "Build unit tests" ON)
 
