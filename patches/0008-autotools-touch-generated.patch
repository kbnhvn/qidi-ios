diff --git a/deps/+GMP/GMP.cmake b/deps/+GMP/GMP.cmake
index 8d96266..b98beb4 100644
--- a/deps/+GMP/GMP.cmake
+++ b/deps/+GMP/GMP.cmake
@@ -85,6 +85,12 @@ else ()
 
     ExternalProject_Add(dep_GMP
         EXCLUDE_FROM_ALL ON
+        # Les archives autotools livrent aclocal.m4/configure/Makefile.in avec des
+        # horodatages trop proches (voire égaux) : make croit devoir les régénérer
+        # avec autoconf/automake, absents du runner -> « automake-1.16: command not
+        # found ». On les touche pour qu'ils soient strictement plus récents que
+        # leurs dépendances ; aucun outil supplémentaire n'est nécessaire.
+        PATCH_COMMAND ${CMAKE_COMMAND} -E touch aclocal.m4 configure Makefile.in
         # gmplib.org est régulièrement injoignable depuis un runner (timeout
         # status 28 constaté). ExternalProject essaie chaque URL dans l'ordre ;
         # le URL_HASH ci-dessous reste la preuve qu'on obtient le bon fichier.
