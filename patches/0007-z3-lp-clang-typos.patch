+# Deux coquilles latentes de z3 4.13.0 (solveur LP) ne sont instanciées que dans
+# certaines configurations : AppleClang récent les refuse (no member named 'get',
+# no member named 'm_low_bound'). Le patch ci-dessous les corrige ; il est appliqué
+# par ExternalProject juste après l'extraction.
 add_cmake_project(z3
   URL https://github.com/Z3Prover/z3/archive/refs/tags/z3-4.13.0.zip
   URL_HASH SHA256=81543736dcbbbcb037a7df55d0be596245d509f3f69f56610df32728e48ee050
+  PATCH_COMMAND ${PATCH_CMD} ${CMAKE_CURRENT_LIST_DIR}/z3-lp-clang-typos.patch
   CMAKE_ARGS
     -DCMAKE_POSITION_INDEPENDENT_CODE=ON
     -DZ3_INCLUDE_GIT_HASH=OFF
