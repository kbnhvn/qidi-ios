diff --git a/deps/+z3/z3.cmake b/deps/+z3/z3.cmake
index 81736d3..483d476 100644
--- a/deps/+z3/z3.cmake
+++ b/deps/+z3/z3.cmake
@@ -1,6 +1,11 @@
+# Cinq coquilles latentes de z3 4.13.0 (solveur LP) ne sont instanciées que dans
+# certaines configurations : AppleClang récent les refuse (no member named 'get',
+# 'get_value_of_column_cell', 'm_low_bound'...). Le patch ci-dessous les corrige ;
+# ExternalProject l'applique juste après l'extraction.
 add_cmake_project(z3
   URL https://github.com/Z3Prover/z3/archive/refs/tags/z3-4.13.0.zip
   URL_HASH SHA256=81543736dcbbbcb037a7df55d0be596245d509f3f69f56610df32728e48ee050
+  PATCH_COMMAND ${PATCH_CMD} ${CMAKE_CURRENT_LIST_DIR}/z3-lp-clang-typos.patch
   CMAKE_ARGS
     -DCMAKE_POSITION_INDEPENDENT_CODE=ON
     -DZ3_INCLUDE_GIT_HASH=OFF
diff --git a/deps/+z3/z3-lp-clang-typos.patch b/deps/+z3/z3-lp-clang-typos.patch
new file mode 100644
index 0000000..0ab5259
--- /dev/null
+++ b/deps/+z3/z3-lp-clang-typos.patch
@@ -0,0 +1,50 @@
+--- a/src/math/lp/static_matrix.h	2024-03-07 19:25:16.000000000 +0100
++++ b/src/math/lp/static_matrix.h	2026-10-18 02:04:22.388813269 +0200
+@@ -79,7 +79,7 @@
+         ref(static_matrix & m, unsigned row, unsigned col):m_matrix(m), m_row(row), m_col(col) {}
+         ref & operator=(T const & v) { m_matrix.set( m_row, m_col, v); return *this; }
+ 
+-        ref operator=(ref & v) { m_matrix.set(m_row, m_col, v.m_matrix.get(v.m_row, v.m_col)); return *this; }
++        ref operator=(ref & v) { m_matrix.set(m_row, m_col, v.m_matrix.get_elem(v.m_row, v.m_col)); return *this; }
+ 
+         operator T () const { return m_matrix.get_elem(m_row, m_col); }
+     };
+--- a/src/math/lp/column_info.h	2024-03-07 19:25:16.000000000 +0100
++++ b/src/math/lp/column_info.h	2026-10-18 02:04:22.389153748 +0200
+@@ -47,7 +47,7 @@
+             m_lower_bound_is_strict == c.m_lower_bound_is_strict &&
+             m_upper_bound_is_set == c.m_upper_bound_is_set&&
