diff --git a/deps/+GMP/GMP.cmake b/deps/+GMP/GMP.cmake
index a05ddd9..f1c7342 100644
--- a/deps/+GMP/GMP.cmake
+++ b/deps/+GMP/GMP.cmake
@@ -79,7 +79,12 @@ else ()
 
     ExternalProject_Add(dep_GMP
         EXCLUDE_FROM_ALL ON
+        # gmplib.org est régulièrement injoignable depuis un runner (timeout
+        # status 28 constaté). ExternalProject essaie chaque URL dans l'ordre ;
+        # le URL_HASH ci-dessous reste la preuve qu'on obtient le bon fichier.
         URL https://gmplib.org/download/gmp/gmp-6.2.1.tar.bz2
+            https://ftp.gnu.org/gnu/gmp/gmp-6.2.1.tar.bz2
+            https://mirrors.kernel.org/gnu/gmp/gmp-6.2.1.tar.bz2
         URL_HASH SHA256=eae9326beb4158c386e39a356818031bd28f3124cf915f8c5b1dc4c7a36b4d7c
         DOWNLOAD_DIR ${${PROJECT_NAME}_DEP_DOWNLOAD_DIR}/GMP
         BUILD_IN_SOURCE ON 
